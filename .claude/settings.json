{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test:smoke)",
      "Bash(npm run test:hooks)",
      "Bash(npm run verify)",
      "Bash(npm run check:content)",
      "Bash(npm run check:links)",
      "Bash(npm run release:status)",
      "Bash(npm run verify:deployment)",
      "Bash(npm run test:mcp)",
      "mcp__tgva__*",
      "mcp__next-devtools__nextjs_docs",
      "mcp__next-devtools__nextjs_index",
      "mcp__next-devtools__nextjs_call",
      "mcp__vercel__list_teams",
      "mcp__vercel__list_projects",
      "mcp__vercel__get_project",
      "mcp__vercel__list_deployments",
      "mcp__vercel__get_deployment",
      "mcp__vercel__get_deployment_build_logs",
      "mcp__vercel__list_deployment_events",
      "mcp__vercel__get_runtime_logs",
      "mcp__vercel__get_runtime_errors",
      "mcp__vercel__web_fetch_vercel_url"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr merge --admin *)",
      "Bash(gh pr merge * --admin *)",
      "Bash(gh pr merge * --admin)",
      "Bash(vercel)",
      "Bash(vercel --prod *)",
      "Bash(vercel deploy *)",
      "Bash(vercel deploy)",
      "Bash(vercel promote *)",
      "Bash(vercel rollback *)",
      "Bash(vercel redeploy *)",
      "mcp__vercel__deploy_to_vercel",
      "mcp__vercel__create_deployment",
      "mcp__vercel__cancel_deployment",
      "mcp__vercel__upload_file",
      "mcp__vercel__import-claude-design-from-url"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}