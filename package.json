{
  "name": "tgva",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "tsx scripts/check-links.ts",
    "release:status": "tsx scripts/release-status.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "test:hooks": "node --test 'tests/hooks/*.test.mjs'",
    "test:mcp": "node --test 'tests/mcp/*.test.mjs'",
    "test:smoke": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:content && npm run test:hooks && npm run test:mcp && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "zod": "^4.6.7"
  }
}
