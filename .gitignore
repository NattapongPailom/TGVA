# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large source media — masters never belong in the repo; they live in
# ../_source-media/ and are re-encoded from there.
*.mov
*.mp4
*.webm

# The web-encoded files the site actually streams are the exception: they are
# small (7.5 MB all told) and a clone or a deploy without them shows a broken
# player, so they are tracked. Captions are plain text and always tracked.
!/public/video/*.mp4

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
